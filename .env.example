# JARVIS 2.0 Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!

# === Phase 2 (LLM & Brain) ===
# Get a Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# === Phase 0.5 (Provider-agnostic model layer) ===
# Optional. AI Partner routes around any provider with no key set, so these are
# not required — but each one you add widens the pool of models it can choose
# from. Never commit a real key.

# OpenRouter — many free models (Nemotron, Ling, ...).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenCode Zen — hosts the community free models (Space Bunny, Big Pickle, ...).
# This is a SEPARATE provider from OpenRouter; these model ids are NOT on
# OpenRouter.
OPENCODE_ZEN_API_KEY=

# === Phase 1 Tools (Security-hardened) ===
# NASA APOD API Key: https://api.nasa.gov/ (Default DEMO_KEY works with rate limits)
NASA_API_KEY=DEMO_KEY

# Gmail SMTP Configuration (Use Google App Password, NOT your personal account password)
# Tutorial: https://support.google.com/accounts/answer/185833
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# === Voice Engine (Chatterbox TTS) ===
# No API key needed! Chatterbox TTS runs 100% locally and free (configured in config.yaml,
# reference voice: Model/chatterbox_emotion_test.wav).

# Picovoice Porcupine AccessKey for wake-word (Phase 6): https://picovoice.ai/console/
PICOVOICE_ACCESS_KEY=your_picovoice_access_key_here
